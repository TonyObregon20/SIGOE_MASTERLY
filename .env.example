# Configuración local. Completa los valores solo en .env; nunca los subas a Git.
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
APP_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Envío de correos
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Recuperación de contraseña
PASSWORD_RESET_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5

# Recuperación inicial de administración: desactivada si no se configura.
# Actívala únicamente de forma temporal y con una contraseña privada fuerte.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
