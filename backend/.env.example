# Configuración local. Completa los valores solo en .env; nunca los subas a Git.
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
APP_URL=http://localhost:3000

# Recuperación inicial de administración: desactivada si no se configura.
# Actívala únicamente de forma temporal y con una contraseña privada fuerte.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
